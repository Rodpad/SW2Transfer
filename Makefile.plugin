#---------------------------------------------------------------------------------
# SW2Transfer background plugin: a kaiHEN plugin (NSO) with the app's HTTP
# server and no screen. Experimental, not released yet.
#
#   make -f Makefile.plugin          builds sw2transfer-plugin.nso
#   make -f Makefile.plugin clean
#
# Install: copy sw2transfer-plugin.nso to /kaihen/plugins/sw2transfer.nso on the
# SD card and restart the console. /kaihen/plugin-status.txt shows whether it
# started; its log is /switch/sw2transfer/plugin-log.txt.
#---------------------------------------------------------------------------------
ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO in your environment. export DEVKITPRO=<path to>/devkitpro")
endif

include $(DEVKITPRO)/libounce/switch2_rules

TARGET      := sw2transfer-plugin
BUILD       := build-plugin
APP_VERSION := $(shell sed -n 's/^APP_VERSION[[:space:]]*:=[[:space:]]*//p' Makefile)

# Close to the app (which has 3 buffers per connection, 64 spare, 16
# connections): the plugin process may use 210 MB and runs at about 64.
# Still 8 transfers at once, what the clients use.
SIZES    := -DSW2_CHUNK=1048576 -DSW2_NBUF=2 -DSW2_POOL_MAX=8 -DSW2_MAX_CONNECTIONS=12 -DSW2_MAX_TRANSFERS=8

ARCH     := $(SWITCH2_CPU) -mtp=soft -fPIE
CXXFLAGS := -g -Wall -O2 -ffunction-sections -fdata-sections $(ARCH) -std=gnu++17 \
            -D__SWITCH__ -DNDEBUG -DSW2_PLUGIN -DAPP_VERSION=\"$(APP_VERSION)\" $(SIZES) \
            -Isource -I$(LIBNX)/include -I$(PORTLIBS_SWITCH2)/include
LDFLAGS  := -specs=$(LIBNX)/switch.specs -g $(ARCH) -Wl,--gc-sections -Wl,-Map,$(BUILD)/$(TARGET).map
# libounce without mimalloc (see <kaihen/plugin.h>).
LIBS     := -lkaihen_plugin -lounce_core
LIBDIRS  := -L$(PORTLIBS_SWITCH2)/lib -L$(LIBNX)/lib

SRCS     := source/net.cpp source/http.cpp source/ftp.cpp source/vfs.cpp source/ops.cpp source/auth.cpp plugin/plugin_main.cpp
OFILES   := $(patsubst %.cpp,$(BUILD)/%.o,$(SRCS)) $(BUILD)/assets.o
ASSETS   := romfs/web/index.html romfs/web/favicon.png tools/sw2xfer.py

.PHONY: all clean stamp
all: stamp
	@$(MAKE) --no-print-directory -f Makefile.plugin $(TARGET).nso

stamp:
	@# Build stamp (git commit, "+" when there are uncommitted changes), rewritten only when it changes.
	@printf '#define BUILD_ID "%s"\n' "$$(git rev-parse --short HEAD 2>/dev/null)$$(git diff --quiet HEAD 2>/dev/null || echo +)" > source/buildid.h.new
	@cmp -s source/buildid.h.new source/buildid.h && rm source/buildid.h.new || mv source/buildid.h.new source/buildid.h

$(BUILD)/assets.cpp: $(ASSETS) tools/embed_assets.py
	@mkdir -p $(BUILD)
	@python3 tools/embed_assets.py $@ asset_index_html=romfs/web/index.html \
	    asset_favicon_png=romfs/web/favicon.png asset_sw2xfer_py=tools/sw2xfer.py

$(BUILD)/%.o: %.cpp Makefile.plugin
	@mkdir -p $(dir $@)
	@echo $(notdir $<)
	@$(CXX) -MMD -MP $(CXXFLAGS) -c $< -o $@

$(BUILD)/assets.o: $(BUILD)/assets.cpp
	@$(CXX) $(CXXFLAGS) -c $< -o $@

$(BUILD)/$(TARGET).elf: $(OFILES)
	@echo linking $(notdir $@)
	@$(CXX) $(LDFLAGS) $(OFILES) $(LIBDIRS) $(LIBS) -o $@

$(TARGET).nso: $(BUILD)/$(TARGET).elf
	@elf2nso $< $@
	@echo built ... $(notdir $@)

clean:
	@rm -rf $(BUILD) $(TARGET).nso

-include $(OFILES:.o=.d)
